# -*- mode: Makefile; -*-

BuildMode?=debug
ifneq ($(BuildMode),release)
BuildLabel=-$(BuildMode)
endif

Package=ttg

MajorVersionNr=$(shell grep "^ *<MajorVersionNr Value=\"[0-9]*\"/>" $(TTGSRC)/ttg.lpi|sed -e s:"^ *<MajorVersionNr Value=\"\([0-9]*\)\"/>":"\1":g)
MinorVersionNr=$(shell grep "^ *<MinorVersionNr Value=\"[0-9]*\"/>" $(TTGSRC)/ttg.lpi|sed -e s:"^ *<MinorVersionNr Value=\"\([0-9]*\)\"/>":"\1":g)
RevisionNr=$(shell grep "^ *<RevisionNr Value=\"[0-9]*\"/>" $(TTGSRC)/ttg.lpi|sed -e s:"^ *<RevisionNr Value=\"\([0-9]*\)\"/>":"\1":g)
BuildNr=$(shell grep "^ *<BuildNr Value=\"[0-9]*\"/>" $(TTGSRC)/ttg.lpi|sed -e s:"^ *<BuildNr Value=\"\([0-9]*\)\"/>":"\1":g)
APPNAME=$(shell grep "StringTable" $(TTGSRC)/ttg.lpi|sed -e s:"^ *<StringTable LegalCopyright=\"[^\"]*\" \(ProductVersion=\"[^\"]*\" \)\?FileDescription=\"\([^\"]*\)\"/>":'\2':g)

BaseVersion=$(MajorVersionNr).$(MinorVersionNr).$(RevisionNr)
AppVersion=$(Package)-$(BaseVersion)
Version=$(BaseVersion).$(BuildNr)

# PACKAGING RELATED:
TGZBASE=$(Package)_$(Version)
TGZSRC=$(Package)-$(Version)
PKGDIR=$(TTGDIR)/../debianization/packages

ifeq ($(shell uname -o),Cygwin)

MARCH=$(shell uname -m)
ifeq ($(MARCH),i686)
OSBITS=32
ARCH=i386
else
ifeq ($(MARCH),x86_64)
OSBITS=64
ARCH=$(MARCH)
endif
endif

LAZBASE=/cygdrive/c/lazarus$(OSBITS)
FPC=$(LAZBASE)/fpc/3.2.2/bin/$(ARCH)-win$(OSBITS)/fpc
EXEEXT=.exe
else
# Find the Lazarus install dir from the lazbuild program: Debian/Ubuntu ship
# /usr/bin/lazbuild, a symlink (or wrapper) pointing into
# <prefix>/<version>/lazbuild, where <prefix> is /usr/share/lazarus or
# /usr/lib/lazarus depending on the distro release; tools/lazres and
# tools/updatepofiles live beside it.
define find_lazbase
r=$$(readlink -f "$$(command -v lazbuild 2>/dev/null)" 2>/dev/null); \
d=$$(dirname "$$r"); \
if [ -x "$$d/lazbuild" ] && [ -d "$$d/tools" ]; then echo "$$d"; exit; fi; \
f=$$(find /usr/share/lazarus /usr/lib/lazarus -maxdepth 2 -name lazbuild -type f 2>/dev/null | head -1); \
if [ -n "$$f" ]; then dirname "$$f"; else echo /usr/share/lazarus; fi
endef
LAZBASE:=$(shell $(find_lazbase))
FPC=fpc
EXEEXT=
ARCH=$(TargetCPU)
endif

TargetCPU=$(shell $(FPC) -iSP)
TargetOS=$(shell $(FPC) -iSO)
TargetSYS=$(TargetCPU)-$(TargetOS)
BuildId=$(TargetSYS)$(BuildLabel)
TTGEXE=$(TTGDIR)/bin/$(BuildId)/$(Package)$(EXEEXT)
TTGSOLVE=$(TTGDIR)/bin/$(BuildId)/ttgsolve$(EXEEXT)

DBCONVERTDIR=$(RELDIR)/../DBConvert
DBCONVERTSRC=$(DBCONVERTDIR)/src
